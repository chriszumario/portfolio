---
type Props = {
  tag: string;
  count?: number;
};

const { tag, count } = Astro.props;
---

<a
  href={`/blog?tag=${encodeURIComponent(tag)}`}
  data-tag-badge
  data-tag-name={tag}
  class="inline-flex shrink-0 items-center gap-1.5 rounded-full border border-white/10 bg-white/[0.04] px-3 py-1 text-xs font-semibold text-slate-300 transition duration-200 hover:border-emerald-300/30 hover:bg-emerald-300/[0.06] hover:text-emerald-100 focus-visible:outline-2 focus-visible:outline-emerald-300"
>
  <span>#{tag}</span>
  {count !== undefined && (
    <span class="rounded-full bg-slate-800 px-1.5 py-0.2 text-[10px] font-bold text-slate-400">
      {count}
    </span>
  )}
</a>
