---
import Badge from '../../components/ui/Badge.astro';
import type { Experience } from './types';
import { formatDateRange } from '../../lib/format';
import { safeExternalUrl } from '../../lib/api-contracts';

type Props = {
  item: Experience;
};

const { item } = Astro.props;
const companyUrl = safeExternalUrl(item.company_url);

const dateRangeFormatted = formatDateRange(item.start_date, item.end_date, item.is_current, 'Presente');
---

<div class="relative group">
  <!-- Timeline glowing node dot centered over left border line -->
  <div class="absolute -left-[31px] sm:-left-[47px] top-1.5 w-4 h-4 rounded-full bg-indigo-500 border-4 border-slate-950 ring-2 ring-indigo-500/40 group-hover:scale-125 group-hover:bg-indigo-400 group-hover:ring-indigo-400/60 transition-all duration-300"></div>

  <!-- 2-Column Item Grid Layout matching reference image -->
  <div class="grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-12 items-start">
    
    <!-- Left Column: Position, Company & Period -->
    <div class="md:col-span-5 space-y-2">
      <h3 class="text-xl sm:text-2xl font-bold text-white font-heading tracking-tight leading-snug group-hover:text-indigo-300 transition-colors">
        {item.position}
      </h3>

      <div class="flex items-center gap-2.5 flex-wrap">
        {companyUrl ? (
          <a
            href={companyUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm sm:text-base font-semibold text-slate-200 hover:text-indigo-400 transition-colors inline-flex items-center gap-1"
            aria-label={`Visitar sitio web de ${item.company}`}
          >
            {item.company}
            <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        ) : (
          <span class="text-sm sm:text-base font-semibold text-slate-200">{item.company}</span>
        )}

        {item.is_current && (
          <Badge variant="emerald" dot={true} size="sm">
            Presente
          </Badge>
        )}
      </div>

      <p class="text-xs sm:text-sm font-medium text-slate-400 font-sans">
        {dateRangeFormatted}
      </p>
    </div>

    <!-- Right Column: Description Text -->
    <div class="md:col-span-7 pt-1 md:pt-0">
      {item.description && (
        <p class="text-slate-300 text-sm sm:text-base leading-relaxed font-sans">
          {item.description}
        </p>
      )}
    </div>

  </div>
</div>
