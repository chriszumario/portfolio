---
import Badge from '../../components/ui/Badge.astro';
import type { Education } from './types';
import { formatDateRange } from '../../lib/format';

type Props = {
  item: Education;
};

const { item } = Astro.props;

const dateRangeFormatted = formatDateRange(item.start_date, item.end_date, item.is_current, 'En curso');
---

<div class="relative group">
  <!-- Timeline glowing node dot centered over left border line -->
  <div class="absolute -left-[31px] sm:-left-[47px] top-1.5 w-4 h-4 rounded-full bg-indigo-500 border-4 border-slate-950 ring-2 ring-indigo-500/40 group-hover:scale-125 group-hover:bg-indigo-400 group-hover:ring-indigo-400/60 transition-all duration-300"></div>

  <!-- 2-Column Item Grid Layout -->
  <div class="grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-12 items-start">
    
    <!-- Left Column: Degree, Institution & Dates -->
    <div class="md:col-span-5 space-y-2">
      <h3 class="text-xl sm:text-2xl font-bold text-white font-heading tracking-tight leading-snug group-hover:text-indigo-300 transition-colors">
        {item.degree}
      </h3>

      <div class="flex items-center gap-2.5 flex-wrap">
        <span class="text-sm sm:text-base font-semibold text-slate-200">{item.institution}</span>

        {item.is_current && (
          <Badge variant="violet" dot={true} size="sm">
            En curso
          </Badge>
        )}
      </div>

      {item.field_of_study && (
        <div>
          <span class="inline-block text-xs font-semibold text-indigo-300 bg-indigo-950/80 px-2.5 py-1 rounded-md border border-indigo-500/30">
            {item.field_of_study}
          </span>
        </div>
      )}

      <p class="text-xs sm:text-sm font-medium text-slate-400 font-sans pt-0.5">
        {dateRangeFormatted}
      </p>
    </div>

    <!-- Right Column: Description Text -->
    <div class="md:col-span-7 pt-1 md:pt-0">
      {item.description && (
        <p class="text-slate-300 text-sm sm:text-base leading-relaxed font-sans">
          {item.description}
        </p>
      )}
    </div>

  </div>
</div>
