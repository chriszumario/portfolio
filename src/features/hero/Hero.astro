---
import Badge from "../../components/ui/Badge.astro";
import Button from "../../components/ui/Button.astro";
import type { Hero } from "./types";
import { safeExternalUrl } from '../../lib/api-contracts';

type Props = {
  data: Hero | null;
};

const { data } = Astro.props;

const hasHero = Boolean(data && data.name && data.name.trim());
const hero = data;
const resumeUrl = safeExternalUrl(hero?.resume_url);

const initials = hero?.name
  ? hero.name
      .split(" ")
      .map((n) => n[0])
      .join("")
      .slice(0, 2)
      .toUpperCase()
  : "CP";

---

{hasHero && hero && (
  <section id="hero" class="pt-28 sm:pt-36 lg:pt-40 pb-16 sm:pb-24 bg-slate-950">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- 2 Column Grid Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      <!-- Left Column: Professional Presentation (Full width on mobile/tablet) -->
      <div class="lg:col-span-7 space-y-6">
        <!-- Availability Badge -->
        {
          hero.is_available && (
            <div class="inline-block">
              <Badge variant="emerald" dot={true} size="md">
                Disponible para proyectos
              </Badge>
            </div>
          )
        }

        <!-- Name & Role Title -->
        <div class="space-y-2.5">
          <span
            class="block font-mono text-xs font-semibold uppercase tracking-[0.2em] text-emerald-300 sm:text-sm"
          >
            Hola, mi nombre es
          </span>
          <h1
            class="text-4xl sm:text-6xl font-extrabold text-white font-heading tracking-tight leading-tight"
          >
            {hero.name}
          </h1>
          <p
            class="font-heading text-xl font-extrabold tracking-tight text-emerald-200 sm:text-3xl"
          >
            {hero.title}
          </p>
          {hero.subtitle && (
            <p class="max-w-2xl text-base font-medium leading-relaxed text-slate-300 sm:text-lg">
              {hero.subtitle}
            </p>
          )}
        </div>

        <!-- Description -->
        <p
          class="text-slate-300 text-base sm:text-lg leading-relaxed font-sans max-w-xl"
        >
          {hero.description}
        </p>

        <!-- Action Buttons (Ver Proyectos & Descargar CV) -->
        <div
          class="pt-4 flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 flex-wrap"
        >
          <Button
            href="/#projects"
            variant="primary"
            size="lg"
            class="w-full justify-center sm:w-auto"
          >
            Ver Proyectos
            <svg
              class="w-5 h-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </Button>

          {
            resumeUrl && (
              <Button
                href={resumeUrl}
                target="_blank"
                rel="noopener noreferrer"
                variant="secondary"
                size="lg"
                class="w-full sm:w-auto justify-center"
              >
                Descargar CV
                <svg
                  class="w-5 h-5 transition-transform group-hover:translate-y-0.5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M12 4.5v11.25m0 0l-3.75-3.75M12 15.75l3.75-3.75M3.75 19.5h16.5"
                  />
                </svg>
              </Button>
            )
          }
        </div>
      </div>

      <!-- Right Column: Tech Emblem Card (Hidden on mobile/tablet, only shown on desktop 'hidden lg:flex') -->
      <div class="hidden lg:flex lg:col-span-5 justify-end">
        <div
          class="relative group transform rotate-2 hover:rotate-0 transition-transform duration-500 ease-out"
        >
          <!-- Glowing Back Aura -->
          <div
            class="absolute -inset-2 rounded-3xl bg-emerald-300/10 blur-xl opacity-50 transition duration-500 group-hover:opacity-80"
          >
          </div>

          <!-- Card Box -->
          <div
            class="relative flex h-64 w-64 flex-col justify-between overflow-hidden rounded-3xl border border-white/10 bg-white/4 p-6 shadow-2xl shadow-black/30 backdrop-blur-xl sm:h-72 sm:w-72"
          >
            <div
              class="flex items-center justify-between border-b border-slate-800 pb-3"
            >
              <div class="flex items-center gap-1.5">
                <span
                  class="w-2.5 h-2.5 rounded-full bg-rose-500/80 inline-block"
                ></span>
                <span
                  class="w-2.5 h-2.5 rounded-full bg-amber-500/80 inline-block"
                ></span>
                <span
                  class="w-2.5 h-2.5 rounded-full bg-emerald-500/80 inline-block"
                ></span>
              </div>
              <span class="font-mono text-[11px] text-slate-500 font-bold"
                >developer.ts</span
              >
            </div>

            <div class="my-auto text-center space-y-3">
              <div
                class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl border border-emerald-300/30 bg-emerald-300/10 font-mono text-2xl font-extrabold text-emerald-200 shadow-xl shadow-black/30 transition-transform group-hover:scale-105 sm:h-20 sm:w-20 sm:text-3xl"
              >
                &lt;{initials} /&gt;
              </div>
              <div class="space-y-1">
                <span
                  class="text-xs font-bold text-slate-200 uppercase tracking-widest font-heading block"
                >
                  {hero.title}
                </span>
                {
                  hero.subtitle && (
                    <span class="text-[11px] text-indigo-400 font-mono block">
                      {hero.subtitle}
                    </span>
                  )
                }
              </div>
            </div>

            <div
              class="pt-3 border-t border-slate-800 flex items-center justify-between text-[11px] font-mono text-slate-400"
            >
              <span class:list={["font-semibold", hero.is_available ? "text-emerald-300" : "text-slate-500"]}>
                {hero.is_available ? "● Disponible" : "○ No disponible"}
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
)}
