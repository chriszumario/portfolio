---
import Button from '../../components/ui/Button.astro';
import type { Project } from './types';
import { resolveApiAssetUrl } from '../../lib/http';
import { safeExternalUrl } from '../../lib/api-contracts';

type Props = {
  project: Project;
};

const { project } = Astro.props;

const imageSrc = resolveApiAssetUrl(project.cover_image_url) ?? "https://images.unsplash.com/photo-1555066931-4365d14bab8c?w=800";
const demoUrl = safeExternalUrl(project.demo_url);
const githubUrl = safeExternalUrl(project.github_url);
---

<article class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-center group">
  
  <!-- Left Side: Image Preview -->
  <div class="lg:col-span-6">
    <div class="relative overflow-hidden rounded-3xl border border-white/10 bg-white/[0.03] shadow-2xl shadow-black/30 transition-colors duration-300 group-hover:border-emerald-300/30">
      <img
        src={imageSrc}
        alt={`Vista previa del proyecto ${project.title}`}
        class="w-full h-52 sm:h-72 lg:h-80 object-cover group-hover:scale-105 transition-transform duration-500"
        width={600}
        height={337}
        loading="lazy"
        decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950/60 via-transparent to-transparent"></div>
    </div>
  </div>

  <!-- Right Side: Content & Actions -->
  <div class="lg:col-span-6 space-y-4">
    
    <!-- Title & Featured Badge -->
    <div class="flex items-center gap-3 flex-wrap">
      <h3 class="text-xl sm:text-2xl lg:text-3xl font-extrabold text-white font-heading tracking-tight leading-snug group-hover:text-indigo-400 transition-colors">
        {project.title}
      </h3>
      {project.is_featured && (
        <span class="inline-flex items-center gap-1 text-amber-400 text-xs font-bold bg-amber-500/10 px-2.5 py-1 rounded-full border border-amber-500/30" title="Proyecto Destacado">
          <svg class="w-3.5 h-3.5 fill-amber-400 text-amber-400" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385c.116.488-.41.87-.83.61l-4.73-2.75a.566.566 0 00-.572 0l-4.73 2.75c-.42.245-.946-.137-.83-.61l1.285-5.385a.563.563 0 00-.182-.557l-4.204-3.602c-.38-.325-.178-.948.32-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />
          </svg>
          Destacado
        </span>
      )}
    </div>

    <!-- Tags / Tech Stack Icons -->
    {project.tags && project.tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5 sm:gap-2 pt-1 pb-1">
        {project.tags.map((tag) => (
          <span class="text-xs font-semibold text-indigo-300 bg-indigo-950/80 px-2.5 sm:px-3 py-1 rounded-lg border border-indigo-500/30">
            {tag}
          </span>
        ))}
      </div>
    )}

    <!-- Description -->
    <p class="text-slate-300 text-sm sm:text-base leading-relaxed font-sans">
      {project.description}
    </p>

    <!-- Action Buttons (Responsive flex for touch screen targets) -->
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 pt-3">
      {githubUrl && (
        <Button href={githubUrl} target="_blank" rel="noopener noreferrer" variant="secondary" size="md" class="justify-center" aria-label={`Ver código en GitHub de ${project.title}`}>
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
          </svg>
          GitHub
        </Button>
      )}

      {demoUrl && (
        <Button href={demoUrl} target="_blank" rel="noopener noreferrer" variant="primary" size="md" class="justify-center" aria-label={`Ver demo en vivo de ${project.title}`}>
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
          Preview
        </Button>
      )}
    </div>

  </div>

</article>
