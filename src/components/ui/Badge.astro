---
import type { HTMLAttributes } from 'astro/types';

type Props = {
  variant?: 'emerald' | 'violet';
  size?: 'sm' | 'md';
  dot?: boolean;
  role?: HTMLAttributes<'span'>['role'];
  class?: string;
};

const {
  variant = 'emerald',
  size = 'md',
  dot = false,
  role = 'status',
  class: className = '',
} = Astro.props;

// WCAG AA contrast compliant color combinations
const variantStyles = {
  emerald: "bg-emerald-950/60 text-emerald-300 border-emerald-500/30",
  violet: "bg-purple-950/60 text-purple-300 border-purple-500/30",
};

const dotColors = {
  emerald: "bg-emerald-400",
  violet: "bg-purple-400",
};

const sizeStyles = {
  sm: "px-2.5 py-0.5 text-xs font-medium",
  md: "px-3 py-1 text-xs font-semibold",
};

const classes = [
  "inline-flex items-center gap-1.5 rounded-full border tracking-wide select-none",
  variantStyles[variant],
  sizeStyles[size],
  className,
].join(" ");
---

<span class={classes} role={role}>
  {dot && (
    <span class="relative flex h-2 w-2" aria-hidden="true">
      <span class={`animate-ping absolute inline-flex h-full w-full rounded-full opacity-75 ${dotColors[variant]}`}></span>
      <span class={`relative inline-flex rounded-full h-2 w-2 ${dotColors[variant]}`}></span>
    </span>
  )}
  <slot />
</span>
