---
import type { HTMLAttributes } from 'astro/types';

type Props = Omit<HTMLAttributes<'a'>, 'class'> & {
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  href: string;
  class?: string;
};

const {
  variant = 'primary',
  size = 'md',
  href,
  target,
  rel,
  class: className = '',
  ...rest
} = Astro.props;

// Min-height 44px for WCAG 2.2 AA target size compliance
const baseStyles = "inline-flex min-h-11 min-w-11 select-none items-center justify-center gap-2 rounded-full font-semibold transition duration-200 focus-visible:outline-2 focus-visible:outline-emerald-300 focus-visible:outline-offset-2 disabled:cursor-not-allowed disabled:opacity-50";

const variantStyles = {
  primary: "bg-emerald-300 text-slate-950 shadow-lg shadow-emerald-950/30 hover:bg-emerald-200 hover:-translate-y-0.5 active:translate-y-0 motion-reduce:transform-none",
  secondary: "border border-white/10 bg-white/[0.06] text-slate-100 hover:border-white/20 hover:bg-white/10 hover:-translate-y-0.5 active:translate-y-0 motion-reduce:transform-none",
  ghost: "bg-transparent text-slate-300 hover:bg-white/[0.06] hover:text-white"
};

const sizeStyles = {
  sm: "px-3.5 py-2 text-xs",
  md: "px-5 py-2.5 text-sm",
  lg: "px-6 py-3.5 text-base"
};

const classes = [baseStyles, variantStyles[variant], sizeStyles[size], className].join(" ");
---

<a
  href={href}
  target={target}
  rel={rel ?? (target === '_blank' ? 'noopener noreferrer' : undefined)}
  class={classes}
  {...rest}
>
  <slot />
</a>
