---
type Props = {
  eyebrow: string;
  title: string;
  description?: string;
};

const { eyebrow, title, description } = Astro.props;
---

<header class="mb-10 w-full sm:mb-14">
  <p class="mb-3 font-mono text-xs font-semibold uppercase tracking-[0.2em] text-emerald-300">
    {eyebrow}
  </p>
  <h2 class="text-3xl font-extrabold leading-[1.08] tracking-[-0.035em] text-white sm:text-4xl lg:text-5xl">
    {title}
  </h2>
  {description && <p class="mt-4 max-w-2xl text-pretty text-base leading-7 text-slate-400 sm:text-lg">{description}</p>}
</header>
